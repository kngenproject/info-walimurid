rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siswa/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /nilai/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /absensi/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /catatan/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /kelas/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /settings/{id} { allow read: if true; allow write: if request.auth != null; }
  }
}
