rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /siswa/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /nilai/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /absensi/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
