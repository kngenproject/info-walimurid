# === Firebase Config ===
# Salin file ini ke .env, lalu isi nilai sebenarnya dari Firebase Console.
# Setelah diisi, jalankan: bash generate-config.sh

FIREBASE_API_KEY=ISI_API_KEY
FIREBASE_AUTH_DOMAIN=ISI_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=ISI_PROJECT
FIREBASE_STORAGE_BUCKET=ISI_PROJECT.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=ISI_SENDER_ID
FIREBASE_APP_ID=ISI_APP_ID
